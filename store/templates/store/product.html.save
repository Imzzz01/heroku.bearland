{% extends 'store/base.html' %}
{% load static %}

{% block title %}Bear Land - Products{% endblock %}

{% block content %}
<section class="container">
    <h1 class="text-center mt-5">Products</h1>
    <div class="row mt-5">
        {% for product in products %}
        <!-- Individual Product Card -->
        <div class="col-md-4 mb-4">
            <div class="card h-100" data-aos="fade-up">
                <!-- Product Image with consistent sizing -->
                {% if product.image %}
                    <img src="{{ product.image.url }}" class="card-img-top" alt="{{ product.name }}" style="width: 100%; height: 250px; object-fit: cover;">
                {% else %}
                    <!-- Fallback image if there's no product image -->
                    <img src="{% static 'images/no-image.png' %}" class="card-img-top" alt="{{ product.name }}" style="width: 100%; height: 250px; object-fit: cover;">
                {% endif %}
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">{{ product.name }}</h5>
                    <p class="price">£{{ product.price }}</p>
                    <p class="card-text flex-grow-1">{{ product.description|default:"Adopt this bear today!" }}</p>
                    <div class="mt-auto">
                        <!-- Product details and add to cart buttons -->
                        <a href="{% url 'store:product_detail' product.id %}" class="btn btn-outline-primary btn-sm me-2">View Details</a>
                        {% if product.stock > 0 %}
                        <form method="post" action="{% url 'cart:add_to_cart' product.id %}" class="d-inline add-to-cart-form" data-product-id="{{ product.id }}">
                            {% csrf_token %}
                            <input type="hidden" name="quantity" value="1">
                            <button type="submit" class="btn btn-primary btn-sm me-2">
                                <i class="fa fa-cart-plus"></i> Add to Cart
                            </button>
                        </form>
                        {% else %}
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
        {% empty %}
        <!-- Brown Bear Product -->
