                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Brown Bear</h5>
                    <p class="price">£12.00</p>
                    <p class="card-text flex-grow-1">Adopt a brown bear today!</p>
                    <div class="mt-auto">
